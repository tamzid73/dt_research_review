  title = {Microstructure Evolution and Superelasticity of Layer-like {{NiTiNb}} Porous Metal Prepared by Eutectic Reaction},
  author = {Wang, Liqiang and Xie, Lechun and Zhang, Lai-Chang and Chen, Liangyu and Ding, Zihao and Lv, Yuting and Zhang, Wei and Lu, Weijie and Zhang, Di},
