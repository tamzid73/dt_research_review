  title = {High-Resolution Melt Pool Thermal Imaging for Metals Additive Manufacturing Using the Two-Color Method with a Color Camera},
  author = {Myers, Alexander J. and Quirarte, Guadalupe and Ogoke, Francis and Lane, Brandon M. and Uddin, Syed Zia and Farimani, Amir Barati and Beuth, Jack L. and Malen, Jonathan A.},
  year = 2023,
